# Copy to .env and fill locally. Never commit real credentials.
DATABASE_URL=
PORT=3000
DB_POOL_MAX=2
CORS_ORIGINS=
NODE_ENV=development

# Optional Aiven CA certificate as one line with literal \n between PEM lines.
# Required when the server certificate is not trusted by Node's system roots.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Only for npm run test:postgres: a separate, disposable remote test database.
# TEST_DATABASE_URL=
# TEST_DB_SSL_CA=
